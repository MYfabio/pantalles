generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("EDITOR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents  Content[]
}

model Screen {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  location   String?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  contents   ContentScreen[]
  // Which panel this screen displays. Null means the screen shows no panel.
  panelId    String?
  panel      Panel?          @relation(fields: [panelId], references: [id], onDelete: SetNull)
}

model Content {
  id            String          @id @default(cuid())
  title         String
  body          String?
  status        String          @default("DRAFT")
  duration      Int             @default(10)
  department    String?
  generatedHtml String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  authorId      String
  author        User            @relation(fields: [authorId], references: [id])
  screens       ContentScreen[]
}

model ContentScreen {
  contentId String
  screenId  String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  screen    Screen  @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@id([contentId, screenId])
}

// A panel is one full-screen layout: its header settings plus its own blocks.
// Screens point at a panel, so several screens can share one panel or each
// show a different one.
model Panel {
  id                     String       @id @default(cuid())
  name                   String
  logoUrl                String?
  showClock              Boolean      @default(true)
  showWeather            Boolean      @default(true)
  showQuote              Boolean      @default(false)
  quoteText              String?
  showSustainability     Boolean      @default(true)
  sustainabilityImageUrl String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  blocks                 PanelBlock[]
  screens                Screen[]
}

model PanelBlock {
  id        String    @id @default(cuid())
  panelId   String
  panel     Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean   @default(true)
  title     String
  text      String
  date      String
  typeText  String
  imageUrl  String?
  // Optional publication window. Outside it the block is hidden on the public
  // panel, but stays visible in the editor so it can be prepared in advance.
  startsAt  DateTime?
  endsAt    DateTime?
  order     Int
  updatedAt DateTime  @updatedAt

  @@unique([panelId, key])
}

model Settings {
  id             String  @id @default("main")
  schoolName     String  @default("Escola Industrial")
  primaryColor   String  @default("#1a3a5c")
  secondaryColor String  @default("#4a8abf")
  accentColor    String  @default("#6aadde")
  fontTitle      String  @default("Inter")
  fontBody       String  @default("Inter")
  logoUrl        String?
}

model SustainabilityIndicator {
  id           String   @id @default(cuid())
  key          String   @unique
  icon         String
  unitat       String
  valorInicial Float
  increment    Float
  dataInici    String
  frequencia   String   @default("dia")
  enabled      Boolean  @default(true)
  order        Int
  updatedAt    DateTime @updatedAt
}
