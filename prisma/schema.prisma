generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("EDITOR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contents  Content[]
}

model Screen {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  location   String?
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  contents   ContentScreen[]
  // El contingut d'aquesta pantalla. Cada pantalla te el seu (lib/screen-panel.ts
  // el crea o el separa en obrir l'editor); nul vol dir que encara no s'ha editat.
  panelId    String?
  panel      Panel?          @relation(fields: [panelId], references: [id], onDelete: SetNull)
  // El contingut que tenia abans de "carregar el d'una altra pantalla", per desfer-ho.
  previousPanelId String?
  urls       ScreenUrl[]
}

// One entry in a screen's rotation. The player device asks Kiosko what to show
// instead of holding its own list, so the rotation is managed from the web and
// nobody has to walk up to a screen to change it.
model ScreenUrl {
  id        String   @id @default(cuid())
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  label     String
  url       String
  seconds   Int      @default(30)
  enabled   Boolean  @default(true)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([screenId, order])
}

model Content {
  id            String          @id @default(cuid())
  title         String
  body          String?
  status        String          @default("DRAFT")
  duration      Int             @default(10)
  department    String?
  generatedHtml String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  authorId      String
  author        User            @relation(fields: [authorId], references: [id])
  screens       ContentScreen[]
}

model ContentScreen {
  contentId String
  screenId  String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  screen    Screen  @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@id([contentId, screenId])
}

// A panel is one full-screen layout: its header settings plus its own blocks.
// Each screen owns exactly one; content is copied between screens, never shared.
model Panel {
  id                     String       @id @default(cuid())
  name                   String
  logoUrl                String?
  showClock              Boolean      @default(true)
  showWeather            Boolean      @default(true)
  showQuote              Boolean      @default(false)
  quoteText              String?
  showSustainability     Boolean      @default(true)
  sustainabilityImageUrl String?
  // Aparenca propia del panell. Nuls = hereta el granat del centre (lib/panel-theme.ts).
  themePrimary           String?
  themeDark              String?
  fontScale              Float        @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  blocks                 PanelBlock[]
  screens                Screen[]
}

model PanelBlock {
  id        String    @id @default(cuid())
  panelId   String
  panel     Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean   @default(true)
  title     String
  text      String
  date      String
  typeText  String
  imageUrl  String?
  // Video curt sense so; si n'hi ha, imageUrl fa de fotograma de reserva.
  videoUrl  String?
  // Imatge o video a tota la pantalla sota la capcalera; mentre es actiu, amaga els altres blocs.
  fullBleed Boolean   @default(false)
  // Optional publication window. Outside it the block is hidden on the public
  // panel, but stays visible in the editor so it can be prepared in advance.
  startsAt  DateTime?
  endsAt    DateTime?
  order     Int
  updatedAt DateTime  @updatedAt

  @@unique([panelId, key])
}

model Settings {
  id             String  @id @default("main")
  schoolName     String  @default("Escola Industrial")
  primaryColor   String  @default("#1a3a5c")
  secondaryColor String  @default("#4a8abf")
  accentColor    String  @default("#6aadde")
  fontTitle      String  @default("Inter")
  fontBody       String  @default("Inter")
  logoUrl        String?
}

// Uploaded and AI-generated images, kept in the database so the app needs no
// external file service. Served by /api/images/[id]. Rows are immutable, which
// lets that route send them with a long cache lifetime.
model StoredImage {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())
}

model SustainabilityIndicator {
  id           String   @id @default(cuid())
  key          String   @unique
  icon         String
  unitat       String
  valorInicial Float
  increment    Float
  dataInici    String
  frequencia   String   @default("dia")
  enabled      Boolean  @default(true)
  order        Int
  updatedAt    DateTime @updatedAt
}
